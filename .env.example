# Supabase project credentials.
# Settings -> API in the Supabase dashboard. Copy this file to .env.local for local dev.
# The anon key is a public, browser-safe key — it is protected by Row Level Security, not secrecy.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Base path the app is served from. GitHub Pages serves project sites at /<repo-name>/.
# Leave as "/" for local dev, a custom domain, or a <user>.github.io root repo.
VITE_BASE_PATH="/"
